<?xml version="1.0" encoding="UTF-8"?>
<grit latest_public_release="0" current_release="1" source_lang_id="en" enc_check="möl">
<outputs>
<output filename="grit/crquickshare_strings.h" type="rc_header"><emit emit_type="prepend"></emit></output>
<output filename="crquickshare_strings_en-US.pak" type="data_package" lang="en"/>
<output filename="crquickshare_strings_zh-CN.pak" type="data_package" lang="zh-CN"/>
