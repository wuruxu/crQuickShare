<translation id="5941711191222866238">تصغير</translation>
<translation id="1398853756734560583">تكبير</translation>
<translation id="3157931365184549694">استعادة</translation>
<translation id="6040143037577758943">إغلاق</translation>
<translation id="8181876038280848864">شارك الملفات عبر الشبكة المحلية دون تسجيل الدخول إلى Google.</translation>
<translation id="2804694785588298928">استقبال لمدة 10 دقائق</translation>
<translation id="8235434987148291431">إيقاف الاستقبال</translation>
<translation id="6720792508518440468">اختيار الملفات (حتى 1024)</translation>
<translation id="7074670349438858233">مخفي عن الأجهزة القريبة</translation>
<translation id="1136534526719901357">مرئي للجميع على هذه الشبكة لمدة تصل إلى 10 دقائق</translation>
<translation id="953692523250483872">لم يتم اختيار ملفات</translation>
<translation id="1219749905305551951">الأجهزة القريبة</translation>
<translation id="7989784335483577523">افتح Quick Share على الجهاز الآخر واجعله مرئيًا للجميع. يجب أن يكون الجهازان على الشبكة نفسها.</translation>
<translation id="5027188696592292896">جاهز للمشاركة</translation>
<translation id="5737164735602202642">جارٍ إنشاء اتصال آمن…</translation>
<translation id="7327232760987881796">ملفات واردة — تحقّق من الرمز قبل القبول</translation>
<translation id="5813147605491386311">قارن الرمز على الجهازين قبل المتابعة</translation>
<translation id="674352937515546162">في انتظار الجهاز الآخر…</translation>
<translation id="9160972414642256993">جارٍ استقبال الملفات…</translation>
<translation id="2720604938272916375">جارٍ إرسال الملفات…</translation>
<translation id="3580456221777141248">اكتمل النقل</translation>
<translation id="3834935128831710195">تم رفض النقل</translation>
<translation id="558345155424485441">تم إلغاء النقل</translation>
<translation id="8371969725114387366">تعذّر النقل. تحقّق من الاتصال والمساحة المتاحة وأذونات الملفات، ثم أعد المحاولة.</translation>
<translation id="5336482190349592693">الرمزان متطابقان — متابعة</translation>
<translation id="6452181791372256707">رفض</translation>
<translation id="7658239707568436148">إلغاء</translation>
<translation id="6002049034818931553">الحفظ في:</translation>
<translation id="6818978617725048861">رمز التحقّق: <ph name="CODE"/></translation>
<translation id="3786167654761312760">اكتشاف الأجهزة المحلية غير متاح. تحقّق من الشبكة ومنفذ UDP 5353، ثم أعد تشغيل crQuickShare.</translation>
<translation id="9048139735985720549">إرسال الملفات المختارة إلى هذا الجهاز</translation>
<translation id="8239476720121986113">تم إرسال الملفات. أغلق الجهاز الآخر الاتصال دون تأكيد الاستلام.</translation>
<translation id="6942973706240438936">انتهت مهلة النقل. يُرجى المحاولة مرة أخرى.</translation>
<translation id="580639705303209941">البحث عن هواتف قريبة</translation>
<translation id="2522318852650576992">إيقاف البحث</translation>
<translation id="1786570139860190731">جارٍ بدء المساعدة في الاكتشاف عبر Bluetooth…</translation>
<translation id="5225613818615099949">جارٍ إرسال إشارة إلى الهواتف القريبة لمدة تصل إلى دقيقتين. أبقِ Bluetooth مفعّلًا واتصل بالشبكة نفسها.</translation>
<translation id="9208413327757315813">المساعدة عبر Bluetooth غير متاحة. افتح شاشة الاستقبال في Quick Share على هاتفك. لا تزال المشاركة عبر الشبكة المحلية متاحة.</translation>
  <translation id="7295294312375734147">جهاز Quick Share قريب</translation>
  <translation id="5026581245371276479">بلوتوث فقط</translation>
  <translation id="7108699793566969157">تم اكتشاف الجهاز عبر البلوتوث. اتصل بالشبكة نفسها لإرسال الملفات.</translation>
  <translation id="5835513660254436267">جارٍ البحث عن أجهزة Quick Share القريبة عبر البلوتوث.</translation>
  <translation id="8952915576472102937">اكتشاف البلوتوث غير متاح. يظل اكتشاف الشبكة المحلية متاحاً عند الاتصال بشبكة.</translation>
  <translation id="2538229999269666773">الملف</translation>
  <translation id="6810075817102686774">الملفات المنقولة</translation>
  <translation id="7962960561507616835">سرعة النقل</translation>
  <translation id="4816292591240970283">الوقت المتبقي (دقيقة:ثانية)</translation>
<translation id="1431933172646212969">يتم الاحتفاظ ببنية المجلدات وتخطي المجلدات الفارغة. يمكن نقل ما يصل إلى 1024 ملف في المرة الواحدة، بما في ذلك الملفات داخل المجلدات. قد يتعامل الجهاز المستلِم مع المجلدات بشكل مختلف.</translation>
<translation id="4532845899244822526">اختيار مجلد</translation>
<translation id="9186448452346591728">تم اختيار <ph name="COUNT"/> من العناصر</translation>
  <translation id="5125731858634756748">جارٍ استعادة اتصال الشبكة…</translation>
  <translation id="3851611281675392532">لم تكتمل عملية تنظيف إعدادات الشبكة. تحقق من اتصال Wi-Fi.</translation>
  <translation id="6873287799323878567">Wi-Fi غير متاح. اختر ملفات أقل أو أصغر لإرسالها عبر Bluetooth.</translation>
</translationbundle>
